# PostgreSQL connection string for the HRMS database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Set DATABASE_SSL=false only for a local, non-SSL database
DATABASE_SSL=true

# Outgoing HRMS email (SMTP credentials for hello@leafydigital.in)
SMTP_HOST=smtp.your-email-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@leafydigital.in
SMTP_PASS=replace-with-mailbox-or-app-password
MAIL_FROM=hello@leafydigital.in
FRONTEND_URL=http://localhost:5173
# Optional scheduled notification recipient timezone is fixed to Asia/Kolkata.
